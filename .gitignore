audit/

# Iter-15 · T-15g 冗余清理 wave 3
# .codegraph/ 是 codegraph 工具的本地数据目录（含 *.db、诊断脚本 _*.py、
# 大型 dump *.json/*.txt/*.md/*.log），均为本机临时产物，不入仓。
# 目录内已有自己的 .gitignore（只 ignore *.db/*.log），这里把整个目录
# 显式 ignore，避免每轮迭代有几十个 _iter*_xxx.py 污染 git status。
.codegraph/

# vendor/ 是第三方依赖源码 mirror（如 ragflow-plus），体量大、与本仓
# 主代码松耦合（仅通过 packages/rag/src/ragflow.ts graceful 调用）。
# OpenMAIC/ 已在下方独立段落，不受影响（仍受其它规则约束）。
vendor/

# Iter-30 · OpenMAIC/ 是 sibling 仓库的工作副本（用户克隆来做对照参考），
# 0 个 tracked 文件，但每次 git status 占用 N 行屏幕。统一忽略让 status
# 干净。后续若要把 OpenMAIC 引入主代码，应通过 git submodule / vendor/
# 显式集成，而不是直接放工作树。
OpenMAIC/

# Iter-30 · archive/ 下的 untracked 历史脚本污染 status
# archive/ 路径下已有 47 个 git tracked 的归档文件（manifest-legacy / scripts / packages
# 等，为查史保留，不动），但工作树里另有 40+ 个 untracked 历史脚本（_audit_*.py /
# _patch_*.py / _diag_*.mjs 等），既不入仓也不删除。本规则把"archive/scripts/" 路径
# 下的 untracked 文件一并 ignore，让 git status 干净；要复活某段历史脚本时手动 add -f
# 强制入仓。
# 注意：使用 ! 否定模式保留已 tracked 的 archive/scripts/_* 路径
archive/scripts/_*.py
archive/scripts/_*.mjs
archive/scripts/playwright_e2e.mjs
archive/scripts/ragflow_bridge.py
archive/pdf-pages/
archive/public-py/
archive/root-strays/*.png
# 但保留已 git tracked 的 archive/scripts 文件（git ls-files 已记录，! 否定恢复跟踪）
!archive/scripts/_check_commentary.py
!archive/scripts/_dump_chapter3_titles.py
!archive/scripts/_dump_final_animation_script.py
!archive/scripts/_dump_first_commentary.py
!archive/scripts/_dump_first_teacher.py
!archive/scripts/_faq_sample.py
!archive/scripts/_faq_stats.py
!archive/scripts/_find_dirty_titles.py
!archive/scripts/_inspect_led_blocks.py
!archive/scripts/_phase0_audit_code_blocks.py
!archive/scripts/_phase1_test_parser.py
!archive/scripts/_phase2_test_schema_validation.py
!archive/scripts/_phase3_probe_p2_cl_anim.py
!archive/scripts/_phase3_remove_dead_defs.py
!archive/scripts/_phase45_codeflow_smoke.mjs
!archive/scripts/_phase_inject_manim_widget_preview.py
!archive/scripts/_rename_extra_pages.py


