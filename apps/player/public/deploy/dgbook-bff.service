[Unit]
Description=DGBook BFF (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/dgbook/bff
Environment="PYTHONPATH=/opt/dgbook/bff"
ExecStart=/opt/dgbook/bff/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
