  "p12-suntrack": {
    "id": "widget-pid-sim",
    "kind": "widget",
    "widgetType": "simulation",
    "description": "PID 控制器参数整定 — 调整 Kp/Ki/Kd，观察系统响应曲线变化",
    "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>PID控制器</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#fff;color:#0f172a;font-family:system-ui,sans-serif;display:flex;flex-direction:column;min-height:100vh}.header{padding:12px 16px;background:#f0f9ff;border-bottom:1px solid #e0f2fe;display:flex;align-items:center;gap:8px}.header .icon{width:28px;height:28px;background:#0ea5e9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px}.header h3{font-size:14px;font-weight:600;color:#0369a1;flex:1}.header .goal{font-size:11px;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:4px}.panel{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;background:#f8fafc;border-bottom:1px solid #e2e8f0}.ctrl{flex:1;min-width:150px}.ctrl label{font-size:11.5px;color:#64748b;display:block;margin-bottom:3px}.ctrl input[type=range]{width:100%;accent-color:#0ea5e9}.ctrl .val{font-size:15px;font-weight:700;color:#0369a1;font-family:monospace}.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;min-height:240px}canvas{background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;max-width:100%;height:auto}.info{display:flex;gap:12px;padding:10px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;flex-wrap:wrap}.info-item{text-align:center;flex:1;min-width:80px}.info-item .n{font-size:16px;font-weight:700;font-family:monospace;color:#0369a1}.info-item .l{font-size:10.5px;color:#94a3b8}.presets{padding:6px 16px;display:flex;gap:6px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap}.presets button,.btns button{padding:5px 12px;border-radius:6px;border:1px solid #cbd5e1;background:#fff;color:#334155;cursor:pointer;font-size:11.5px}.btns button.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n.canvas-wrap{min-height:260px;position:relative}canvas{width:100%;height:100%;display:block;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px}\n.btns{padding:6px 16px;display:flex;gap:6px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap}\n.btns button{padding:5px 12px;border-radius:6px;border:1px solid #cbd5e1;background:#fff;color:#334155;cursor:pointer;font-size:11.5px;transition:all .15s}\n.btns button.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n</style></head><body>\n<div class=\"header\"><div class=\"icon\">🎛</div><h3>PID 控制器参数整定</h3><span class=\"goal\">🎯 观察 Kp/Ki/Kd 对系统响应的影响</span></div>\n<div class=\"panel\">\n  <div class=\"ctrl\"><label>Kp（比例）</label><input type=\"range\" id=\"kp-slider\" data-var=\"kp\" min=\"0\" max=\"10\" value=\"1.0\" step=\"0.1\"><div class=\"val\"><span id=\"kp-val\">1.0</span></div></div>\n  <div class=\"ctrl\"><label>Ki（积分）</label><input type=\"range\" id=\"ki-slider\" data-var=\"ki\" min=\"0\" max=\"5\" value=\"0\" step=\"0.05\"><div class=\"val\"><span id=\"ki-val\">0.00</span></div></div>\n  <div class=\"ctrl\"><label>Kd（微分）</label><input type=\"range\" id=\"kd-slider\" data-var=\"kd\" min=\"0\" max=\"5\" value=\"0\" step=\"0.05\"><div class=\"val\"><span id=\"kd-val\">0.00</span></div></div>\n  <div class=\"ctrl\"><label>目标值 SP</label><input type=\"range\" id=\"sp-slider\" data-var=\"sp\" min=\"10\" max=\"90\" value=\"50\"><div class=\"val\"><span id=\"sp-val\">50</span></div></div>\n</div>\n<div class=\"btns\">\n  <button id=\"startBtn\" onclick=\"toggleSim()\">▶ 启动</button>\n  <button onclick=\"resetSim()\">↺ 重置</button>\n  <button onclick=\"apPreset(2,0,0)\">纯P控制</button>\n  <button onclick=\"apPreset(2,1,0)\">PI控制</button>\n  <button onclick=\"apPreset(2.5,0.8,0.3)\">PID最优</button>\n</div>\n<div class=\"canvas-wrap\"><canvas id=\"cv\"></canvas></div>\n<div class=\"info\">\n  <div class=\"info-item\"><div class=\"n\" id=\"rise\">-</div><div class=\"l\">上升时间(s)</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"over\">-</div><div class=\"l\">超调量</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"sse\">-</div><div class=\"l\">稳态误差</div></div>\n</div>\n<script>\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nvar running=false,hist=[],t=0,pv=0,integ=0,prevErr=0,maxPv=0,riseT=-1;\nvar dt=0.01,tau=0.5,steps=500;\nfunction resize(){cv.width=cv.parentElement.clientWidth;cv.height=Math.max(cv.parentElement.clientHeight,260);}\nnew ResizeObserver(resize).observe(cv.parentElement);resize();\nfunction gp(){return{kp:+document.getElementById('kp-slider').value,ki:+document.getElementById('ki-slider').value,kd:+document.getElementById('kd-slider').value,sp:+document.getElementById('sp-slider').value};}\nfunction updateLabels(){var p=gp();document.getElementById('kp-val').textContent=p.kp.toFixed(1);document.getElementById('ki-val').textContent=p.ki.toFixed(2);document.getElementById('kd-val').textContent=p.kd.toFixed(2);document.getElementById('sp-val').textContent=p.sp;}\nfunction apPreset(kp,ki,kd){document.getElementById('kp-slider').value=kp;document.getElementById('ki-slider').value=ki;document.getElementById('kd-slider').value=kd;updateLabels();resetSim();toggleSim();}\nfunction resetSim(){running=false;hist=[];t=0;pv=0;integ=0;prevErr=0;maxPv=0;riseT=-1;document.getElementById('startBtn').textContent='▶ 启动';document.getElementById('startBtn').classList.remove('active');document.getElementById('rise').textContent='-';document.getElementById('over').textContent='-';document.getElementById('sse').textContent='-';draw();}\nfunction toggleSim(){if(!running){running=true;document.getElementById('startBtn').textContent='⏸ 暂停';document.getElementById('startBtn').classList.add('active');hist=[];t=0;pv=0;integ=0;prevErr=0;maxPv=0;riseT=-1;simLoop();}else{running=false;document.getElementById('startBtn').textContent='▶ 继续';document.getElementById('startBtn').classList.remove('active');}}\nfunction simLoop(){if(!running)return;var p=gp();\n  for(var i=0;i<5;i++){if(t>=steps)break;var err=p.sp-pv;integ+=err*dt;var deriv=(err-prevErr)/dt;prevErr=err;var u=p.kp*err+p.ki*integ+p.kd*deriv;pv+=(u-pv)*dt/tau;if(pv>maxPv)maxPv=pv;if(riseT<0&&pv>=p.sp*0.9)riseT=t*dt;hist.push({t:t*dt,pv:pv,sp:p.sp});t++;}\n  if(riseT>=0)document.getElementById('rise').textContent=riseT.toFixed(2);\n  var os=p.sp>0?Math.max(0,(maxPv-p.sp)/p.sp*100):0;document.getElementById('over').textContent=os.toFixed(1)+'%';\n  document.getElementById('sse').textContent=Math.abs(p.sp-pv).toFixed(2);\n  draw();if(t<steps)requestAnimationFrame(simLoop);else{running=false;document.getElementById('startBtn').textContent='↺ 重来';document.getElementById('startBtn').classList.remove('active');}\n}\nfunction draw(){var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);var p=gp(),mx=45,my=20,gw=w-mx-15,gh=h-my-35;\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(mx,my+gh);ctx.lineTo(mx+gw,my+gh);ctx.stroke();\n  ctx.fillStyle='#94a3b8';ctx.font='9px monospace';ctx.textAlign='right';ctx.fillText('100',mx-3,my+6);ctx.fillText('0',mx-3,my+gh+3);ctx.fillText('50',mx-3,my+gh/2+3);\n  var spy=my+gh-p.sp/100*gh;ctx.strokeStyle='#dc2626';ctx.lineWidth=1;ctx.setLineDash([5,3]);ctx.beginPath();ctx.moveTo(mx,spy);ctx.lineTo(mx+gw,spy);ctx.stroke();ctx.setLineDash([]);\n  ctx.fillStyle='#dc2626';ctx.font='9px sans-serif';ctx.textAlign='left';ctx.fillText('SP='+p.sp,mx+gw-44,spy-3);\n  if(hist.length<2)return;\n  ctx.strokeStyle='#0ea5e9';ctx.lineWidth=2.5;ctx.beginPath();var mT=steps*dt;\n  hist.forEach(function(d,i){var x=mx+d.t/mT*gw,y=my+gh-Math.max(0,Math.min(100,d.pv))/100*gh;i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);});ctx.stroke();\n}\n['kp-slider','ki-slider','kd-slider','sp-slider'].forEach(function(id){document.getElementById(id).addEventListener('input',updateLabels);});\nupdateLabels();draw();\n\nwindow.addEventListener('message',function(e){\n  var d=e.data;if(!d||!d.type)return;\n  if(d.type==='SET_WIDGET_STATE'&&d.state){\n    Object.entries(d.state).forEach(function(kv){\n      var el=document.getElementById(kv[0]+'-slider')||document.querySelector('[data-var=\"'+kv[0]+'\"]');\n      if(el){el.value=kv[1];el.dispatchEvent(new Event('input',{bubbles:true}));}\n    });\n  }\n  if(d.type==='HIGHLIGHT_ELEMENT'){\n    var el=document.querySelector(d.target);\n    if(el){el.style.outline='3px solid #0ea5e9';el.style.outlineOffset='3px';setTimeout(function(){el.style.outline='';},3000);}\n  }\n});\n</script></body></html>",
