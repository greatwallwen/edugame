{
  "p3-led-blink": {
    "id": "widget-led-sim",
    "kind": "widget",
    "widgetType": "simulation",
    "description": "LED 限流电路模拟器 — 调整电阻值观察电流和亮度变化，理解 I=(V-Vf)/R",
    "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>LED限流电路</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#fff;color:#0f172a;font-family:system-ui,sans-serif;display:flex;flex-direction:column;min-height:100vh}.header{padding:12px 16px;background:#f0f9ff;border-bottom:1px solid #e0f2fe;display:flex;align-items:center;gap:8px}.header .icon{width:28px;height:28px;background:#0ea5e9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px}.header h3{font-size:14px;font-weight:600;color:#0369a1;flex:1}.header .goal{font-size:11px;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:4px}.panel{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;background:#f8fafc;border-bottom:1px solid #e2e8f0}.ctrl{flex:1;min-width:150px}.ctrl label{font-size:11.5px;color:#64748b;display:block;margin-bottom:3px}.ctrl input[type=range]{width:100%;accent-color:#0ea5e9}.ctrl .val{font-size:15px;font-weight:700;color:#0369a1;font-family:monospace}.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;min-height:240px}canvas{background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;max-width:100%;height:auto}.info{display:flex;gap:12px;padding:10px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;flex-wrap:wrap}.info-item{text-align:center;flex:1;min-width:80px}.info-item .n{font-size:16px;font-weight:700;font-family:monospace;color:#0369a1}.info-item .l{font-size:10.5px;color:#94a3b8}.presets{padding:6px 16px;display:flex;gap:6px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap}.presets button,.btns button{padding:5px 12px;border-radius:6px;border:1px solid #cbd5e1;background:#fff;color:#334155;cursor:pointer;font-size:11.5px}.btns button.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}</style></head><body>\n<div class=\"header\"><div class=\"icon\">💡</div><h3>LED 限流电路模拟器</h3><span class=\"goal\">🎯 理解 I=(V-Vf)/R</span></div>\n<div class=\"panel\">\n  <div class=\"ctrl\"><label>限流电阻 R</label><input type=\"range\" id=\"resistance-slider\" data-var=\"resistance\" min=\"100\" max=\"1000\" value=\"220\" step=\"10\"><div class=\"val\"><span id=\"r-val\">220</span> Ω</div></div>\n  <div class=\"ctrl\"><label>GPIO 电压</label><input type=\"range\" id=\"voltage-slider\" data-var=\"voltage\" min=\"0\" max=\"3.3\" value=\"3.3\" step=\"0.1\"><div class=\"val\"><span id=\"v-val\">3.3</span> V</div></div>\n  <div class=\"ctrl\"><label>LED 正向压降</label><input type=\"range\" id=\"vled-slider\" data-var=\"vled\" min=\"1.6\" max=\"2.4\" value=\"2.0\" step=\"0.1\"><div class=\"val\"><span id=\"vl-val\">2.0</span> V</div></div>\n</div>\n<div class=\"canvas-wrap\"><canvas id=\"cv\" width=\"480\" height=\"220\"></canvas></div>\n<div class=\"info\">\n  <div class=\"info-item\"><div class=\"n\" id=\"i-val\">5.91</div><div class=\"l\">电流 I (mA)</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"p-val\">11.82</div><div class=\"l\">功耗 (mW)</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"warn-val\">✓ 正常</div><div class=\"l\">状态</div></div>\n</div>\n<script>\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nvar rs=document.getElementById('resistance-slider'),vs=document.getElementById('voltage-slider'),vls=document.getElementById('vled-slider');\nfunction calc(){\n  var R=+rs.value,V=+vs.value,Vl=+vls.value;\n  document.getElementById('r-val').textContent=R;\n  document.getElementById('v-val').textContent=V.toFixed(1);\n  document.getElementById('vl-val').textContent=Vl.toFixed(1);\n  var I=V>Vl?(V-Vl)/R*1000:0,P=Vl*I;\n  document.getElementById('i-val').textContent=I.toFixed(2);\n  document.getElementById('p-val').textContent=P.toFixed(2);\n  var w=document.getElementById('warn-val');\n  if(I>20){w.textContent='⚠ 过流！';w.style.color='#dc2626';}\n  else if(I<=0){w.textContent='LED熄灭';w.style.color='#94a3b8';}\n  else{w.textContent='✓ 正常';w.style.color='#059669';}\n  draw(R,V,Vl,I);\n}\nfunction draw(R,V,Vl,I){\n  var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);\n  var cy=h/2;\n  // GPIO box\n  ctx.fillStyle='#0369a1';ctx.fillRect(18,cy-18,56,36);\n  ctx.fillStyle='#fff';ctx.font='bold 10px sans-serif';ctx.textAlign='center';ctx.fillText('GPIO',46,cy+4);\n  // wire\n  ctx.strokeStyle='#94a3b8';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(74,cy);ctx.lineTo(115,cy);ctx.stroke();\n  // resistor box\n  ctx.fillStyle='#f1f5f9';ctx.strokeStyle='#cbd5e1';ctx.lineWidth=1.5;ctx.fillRect(115,cy-15,75,30);ctx.strokeRect(115,cy-15,75,30);\n  ctx.fillStyle='#334155';ctx.font='bold 10px monospace';ctx.textAlign='center';ctx.fillText(R+'Ω',152,cy+4);\n  // wire\n  ctx.strokeStyle='#94a3b8';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(190,cy);ctx.lineTo(240,cy);ctx.stroke();\n  // LED circle\n  var bright=Math.min(I/15,1);\n  var ledFill=I>0?('rgba(239,68,68,'+(0.25+bright*0.75)+')'):'#f1f5f9';\n  ctx.beginPath();ctx.arc(265,cy,20,0,Math.PI*2);ctx.fillStyle=ledFill;ctx.fill();ctx.strokeStyle=I>20?'#dc2626':'#cbd5e1';ctx.lineWidth=2;ctx.stroke();\n  if(I>0){ctx.fillStyle='rgba(239,68,68,'+(bright*0.2)+')';ctx.beginPath();ctx.arc(265,cy,32,0,Math.PI*2);ctx.fill();}\n  ctx.fillStyle='#334155';ctx.font='bold 10px sans-serif';ctx.textAlign='center';ctx.fillText('LED',265,cy+4);\n  // wire\n  ctx.strokeStyle='#94a3b8';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(285,cy);ctx.lineTo(345,cy);ctx.stroke();\n  // GND box\n  ctx.fillStyle='#f1f5f9';ctx.strokeStyle='#cbd5e1';ctx.lineWidth=1.5;ctx.fillRect(345,cy-15,55,30);ctx.strokeRect(345,cy-15,55,30);\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='center';ctx.fillText('GND',372,cy+4);\n  // labels\n  ctx.fillStyle='#0369a1';ctx.font='10px sans-serif';ctx.textAlign='left';ctx.fillText('V='+V.toFixed(1)+'V',18,cy-26);\n  ctx.fillText('I='+I.toFixed(2)+'mA',115,cy-22);\n  if(I>0){\n    ctx.fillStyle='rgba(14,165,233,0.6)';ctx.font='9px sans-serif';\n    ['→','→','→'].forEach(function(a,i){ctx.fillText(a,95+i*115,cy+28);});\n  }\n}\nrs.addEventListener('input',calc);vs.addEventListener('input',calc);vls.addEventListener('input',calc);\ncalc();\n\nwindow.addEventListener('message',function(e){\n  var d=e.data;if(!d||!d.type)return;\n  if(d.type==='SET_WIDGET_STATE'&&d.state){\n    Object.entries(d.state).forEach(function(kv){\n      var el=document.getElementById(kv[0]+'-slider')||document.querySelector('[data-var=\"'+kv[0]+'\"]');\n      if(el){el.value=kv[1];el.dispatchEvent(new Event('input',{bubbles:true}));}\n    });\n  }\n  if(d.type==='HIGHLIGHT_ELEMENT'){\n    var el=document.querySelector(d.target);\n    if(el){el.style.outline='3px solid #0ea5e9';el.style.outlineOffset='3px';setTimeout(function(){el.style.outline='';},3000);}\n  }\n});\n</script></body></html>",
    "teacherActions": [
      {
        "id": "ta1",
        "type": "speech",
        "content": "我们来看LED限流电路。GPIO输出3.3V，经过限流电阻后驱动LED"
      },
      {
        "id": "ta2",
        "type": "setState",
        "state": {
          "resistance": "470"
        },
        "label": "安全阻值"
      },
      {
        "id": "ta3",
        "type": "speech",
        "content": "470欧姆时电流约2.8mA，LED安全发光"
      },
      {
        "id": "ta4",
        "type": "setState",
        "state": {
          "resistance": "100"
        },
        "label": "过流演示"
      },
      {
        "id": "ta5",
        "type": "speech",
        "content": "100欧姆时电流超过13mA，长时间会损坏LED"
      }
    ]
  },
  "p4-timer": {
    "id": "widget-timer-calc",
    "kind": "widget",
    "widgetType": "simulation",
    "description": "定时器 PSC/ARR 计算器 — 实时计算溢出周期，理解 T=(PSC+1)*(ARR+1)/SYSCLK",
    "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>定时器计算器</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#fff;color:#0f172a;font-family:system-ui,sans-serif;display:flex;flex-direction:column;min-height:100vh}.header{padding:12px 16px;background:#f0f9ff;border-bottom:1px solid #e0f2fe;display:flex;align-items:center;gap:8px}.header .icon{width:28px;height:28px;background:#0ea5e9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px}.header h3{font-size:14px;font-weight:600;color:#0369a1;flex:1}.header .goal{font-size:11px;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:4px}.panel{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;background:#f8fafc;border-bottom:1px solid #e2e8f0}.ctrl{flex:1;min-width:150px}.ctrl label{font-size:11.5px;color:#64748b;display:block;margin-bottom:3px}.ctrl input[type=range]{width:100%;accent-color:#0ea5e9}.ctrl .val{font-size:15px;font-weight:700;color:#0369a1;font-family:monospace}.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;min-height:240px}canvas{background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;max-width:100%;height:auto}.info{display:flex;gap:12px;padding:10px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;flex-wrap:wrap}.info-item{text-align:center;flex:1;min-width:80px}.info-item .n{font-size:16px;font-weight:700;font-family:monospace;color:#0369a1}.info-item .l{font-size:10.5px;color:#94a3b8}.presets{padding:6px 16px;display:flex;gap:6px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap}.presets button,.btns button{padding:5px 12px;border-radius:6px;border:1px solid #cbd5e1;background:#fff;color:#334155;cursor:pointer;font-size:11.5px}.btns button.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}</style></head><body>\n<div class=\"header\"><div class=\"icon\">⏱</div><h3>定时器 PSC/ARR 计算器</h3><span class=\"goal\">🎯 掌握溢出周期公式</span></div>\n<div class=\"panel\">\n  <div class=\"ctrl\"><label>系统时钟 (MHz)</label><input type=\"range\" id=\"clock-slider\" data-var=\"clock\" min=\"1\" max=\"72\" value=\"72\"><div class=\"val\"><span id=\"clk-val\">72</span> MHz</div></div>\n  <div class=\"ctrl\"><label>预分频 PSC</label><input type=\"range\" id=\"psc-slider\" data-var=\"psc\" min=\"0\" max=\"65535\" value=\"71\"><div class=\"val\"><span id=\"psc-val\">71</span></div></div>\n  <div class=\"ctrl\"><label>自动重装 ARR</label><input type=\"range\" id=\"arr-slider\" data-var=\"arr\" min=\"0\" max=\"65535\" value=\"999\"><div class=\"val\"><span id=\"arr-val\">999</span></div></div>\n</div>\n<div class=\"presets\">\n  <button onclick=\"sp(71,999)\">1ms</button><button onclick=\"sp(71,9999)\">10ms</button><button onclick=\"sp(7199,9999)\">1s</button><button onclick=\"sp(719,999)\">10μs×100=1ms</button>\n</div>\n<div class=\"canvas-wrap\"><canvas id=\"cv\" width=\"520\" height=\"190\"></canvas></div>\n<div class=\"info\">\n  <div class=\"info-item\"><div class=\"n\" id=\"fcnt\">1.000 MHz</div><div class=\"l\">计数频率</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"period\">1.000 ms</div><div class=\"l\">溢出周期 T</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"freq\">1000 Hz</div><div class=\"l\">溢出频率</div></div>\n</div>\n<script>\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nfunction sp(p,a){document.getElementById('psc-slider').value=p;document.getElementById('arr-slider').value=a;calc();}\nfunction fmt(v,unit){return v.toFixed(3)+unit;}\nfunction calc(){\n  var CLK=+document.getElementById('clock-slider').value*1e6;\n  var PSC=+document.getElementById('psc-slider').value,ARR=+document.getElementById('arr-slider').value;\n  document.getElementById('clk-val').textContent=document.getElementById('clock-slider').value;\n  document.getElementById('psc-val').textContent=PSC;\n  document.getElementById('arr-val').textContent=ARR;\n  var fc=CLK/(PSC+1),T=(ARR+1)/fc,f=1/T;\n  document.getElementById('fcnt').textContent=fc>=1e6?(fc/1e6).toFixed(3)+' MHz':(fc/1e3).toFixed(1)+' kHz';\n  document.getElementById('period').textContent=T>=1?T.toFixed(3)+' s':T>=0.001?(T*1e3).toFixed(3)+' ms':(T*1e6).toFixed(1)+' μs';\n  document.getElementById('freq').textContent=f>=1e3?(f/1e3).toFixed(1)+' kHz':f.toFixed(2)+' Hz';\n  draw(ARR,T);\n}\nfunction draw(ARR,T){\n  var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);\n  var mx=50,my=28,gw=w-mx-20,gh=h-my-38;\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(mx,my+gh);ctx.lineTo(mx+gw,my+gh);ctx.stroke();\n  ctx.fillStyle='#94a3b8';ctx.font='10px monospace';ctx.textAlign='right';\n  ctx.fillText(ARR,mx-4,my+8);ctx.fillText('0',mx-4,my+gh+3);\n  ctx.textAlign='center';ctx.fillText('时间→',mx+gw/2,my+gh+28);\n  var cyc=3,cw=gw/cyc;\n  ctx.strokeStyle='#0ea5e9';ctx.lineWidth=2.5;ctx.beginPath();\n  for(var c=0;c<cyc;c++){var x0=mx+c*cw;ctx.moveTo(x0,my+gh);ctx.lineTo(x0+cw-2,my);ctx.moveTo(x0+cw-2,my);ctx.lineTo(x0+cw-2,my+gh);}\n  ctx.stroke();\n  ctx.strokeStyle='#f97316';ctx.lineWidth=1;ctx.setLineDash([4,4]);ctx.beginPath();ctx.moveTo(mx,my-8);ctx.lineTo(mx+cw,my-8);ctx.stroke();ctx.setLineDash([]);\n  var tL=T>=1?T.toFixed(3)+'s':T>=0.001?(T*1e3).toFixed(3)+'ms':(T*1e6).toFixed(0)+'μs';\n  ctx.fillStyle='#f97316';ctx.font='bold 11px sans-serif';ctx.textAlign='center';ctx.fillText('T = '+tL,mx+cw/2,my-14);\n  ctx.strokeStyle='#dc2626';ctx.lineWidth=1;ctx.setLineDash([5,3]);ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(mx+gw,my);ctx.stroke();ctx.setLineDash([]);\n  ctx.fillStyle='#dc2626';ctx.font='10px monospace';ctx.textAlign='right';ctx.fillText('ARR='+ARR,mx+gw,my-3);\n}\n['clock-slider','psc-slider','arr-slider'].forEach(function(id){document.getElementById(id).addEventListener('input',calc);});\ncalc();\n\nwindow.addEventListener('message',function(e){\n  var d=e.data;if(!d||!d.type)return;\n  if(d.type==='SET_WIDGET_STATE'&&d.state){\n    Object.entries(d.state).forEach(function(kv){\n      var el=document.getElementById(kv[0]+'-slider')||document.querySelector('[data-var=\"'+kv[0]+'\"]');\n      if(el){el.value=kv[1];el.dispatchEvent(new Event('input',{bubbles:true}));}\n    });\n  }\n  if(d.type==='HIGHLIGHT_ELEMENT'){\n    var el=document.querySelector(d.target);\n    if(el){el.style.outline='3px solid #0ea5e9';el.style.outlineOffset='3px';setTimeout(function(){el.style.outline='';},3000);}\n  }\n});\n</script></body></html>",
    "teacherActions": [
      {
        "id": "ta1",
        "type": "speech",
        "content": "定时器核心公式：T = (PSC+1) * (ARR+1) / 系统时钟"
      },
      {
        "id": "ta2",
        "type": "setState",
        "state": {
          "psc": "71",
          "arr": "999"
        },
        "label": "1ms定时"
      },
      {
        "id": "ta3",
        "type": "speech",
        "content": "PSC=71将72MHz分为1MHz，ARR=999每千个计数溢出，恰好1毫秒"
      }
    ]
  },
  "p5-pwm": {
    "id": "widget-pwm-viz",
    "kind": "widget",
    "widgetType": "simulation",
    "description": "PWM 波形可视化 — 调整占空比观察等效电压，理解 Vavg = D * Vmax",
    "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>PWM可视化</title><style>*{margin:0;padding:0;box-sizing:border-box}body{background:#fff;color:#0f172a;font-family:system-ui,sans-serif;display:flex;flex-direction:column;min-height:100vh}.header{padding:12px 16px;background:#f0f9ff;border-bottom:1px solid #e0f2fe;display:flex;align-items:center;gap:8px}.header .icon{width:28px;height:28px;background:#0ea5e9;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px}.header h3{font-size:14px;font-weight:600;color:#0369a1;flex:1}.header .goal{font-size:11px;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:4px}.panel{padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;background:#f8fafc;border-bottom:1px solid #e2e8f0}.ctrl{flex:1;min-width:150px}.ctrl label{font-size:11.5px;color:#64748b;display:block;margin-bottom:3px}.ctrl input[type=range]{width:100%;accent-color:#0ea5e9}.ctrl .val{font-size:15px;font-weight:700;color:#0369a1;font-family:monospace}.canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;min-height:240px}canvas{background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;max-width:100%;height:auto}.info{display:flex;gap:12px;padding:10px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;flex-wrap:wrap}.info-item{text-align:center;flex:1;min-width:80px}.info-item .n{font-size:16px;font-weight:700;font-family:monospace;color:#0369a1}.info-item .l{font-size:10.5px;color:#94a3b8}.presets{padding:6px 16px;display:flex;gap:6px;background:#f8fafc;border-bottom:1px solid #e2e8f0;flex-wrap:wrap}.presets button,.btns button{padding:5px 12px;border-radius:6px;border:1px solid #cbd5e1;background:#fff;color:#334155;cursor:pointer;font-size:11.5px}.btns button.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n.canvas-wrap{min-height:250px;position:relative}canvas{width:100%;height:100%;display:block;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px}\n</style></head><body>\n<div class=\"header\"><div class=\"icon\">📊</div><h3>PWM 波形可视化</h3><span class=\"goal\">🎯 理解占空比与等效电压 Vavg = D × Vmax</span></div>\n<div class=\"panel\">\n  <div class=\"ctrl\"><label>占空比 D</label><input type=\"range\" id=\"duty-slider\" data-var=\"duty\" min=\"0\" max=\"100\" value=\"50\"><div class=\"val\"><span id=\"d-val\">50</span>%</div></div>\n  <div class=\"ctrl\"><label>幅值 Vmax</label><input type=\"range\" id=\"amp-slider\" data-var=\"amp\" min=\"0\" max=\"3.3\" value=\"3.3\" step=\"0.1\"><div class=\"val\"><span id=\"a-val\">3.3</span> V</div></div>\n  <div class=\"ctrl\"><label>频率</label><input type=\"range\" id=\"freq-slider\" data-var=\"freq\" min=\"100\" max=\"10000\" value=\"1000\" step=\"100\"><div class=\"val\"><span id=\"f-val\">1.0</span> kHz</div></div>\n</div>\n<div class=\"canvas-wrap\"><canvas id=\"cv\"></canvas></div>\n<div class=\"info\">\n  <div class=\"info-item\"><div class=\"n\" id=\"vavg\">1.65 V</div><div class=\"l\">等效电压 Vavg</div></div>\n  <div class=\"info-item\"><div class=\"n\" id=\"tval\">1.000 ms</div><div class=\"l\">周期 T</div></div>\n</div>\n<script>\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');var off=0;\nfunction resize(){cv.width=cv.parentElement.clientWidth;cv.height=Math.max(cv.parentElement.clientHeight,250);}\nnew ResizeObserver(resize).observe(cv.parentElement);resize();\nfunction update(){\n  var D=+document.getElementById('duty-slider').value/100,F=+document.getElementById('freq-slider').value,A=+document.getElementById('amp-slider').value;\n  document.getElementById('d-val').textContent=Math.round(D*100);\n  document.getElementById('a-val').textContent=A.toFixed(1);\n  document.getElementById('f-val').textContent=F>=1000?(F/1000).toFixed(1):F;\n  document.getElementById('vavg').textContent=(D*A).toFixed(2)+' V';\n  var T=1/F;document.getElementById('tval').textContent=T>=0.001?(T*1e3).toFixed(3)+' ms':(T*1e6).toFixed(1)+' μs';\n}\nfunction draw(){\n  var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);\n  var D=+document.getElementById('duty-slider').value/100,A=+document.getElementById('amp-slider').value;\n  var mx=50,my=25,gw=w-mx-15,pwmH=(h-70)/2-10,avgY=my+pwmH+50;\n  ctx.fillStyle='#64748b';ctx.font='bold 11px sans-serif';ctx.textAlign='left';ctx.fillText('PWM 输出波形',mx,my-8);\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(mx,my+pwmH);ctx.lineTo(mx+gw,my+pwmH);ctx.stroke();\n  ctx.textAlign='right';ctx.font='9px monospace';ctx.fillStyle='#94a3b8';ctx.fillText(A.toFixed(1)+'V',mx-3,my+6);ctx.fillText('0V',mx-3,my+pwmH+3);\n  var cyc=4,cw=gw/cyc;\n  ctx.strokeStyle='#0ea5e9';ctx.lineWidth=2.5;ctx.beginPath();\n  for(var c=0;c<cyc;c++){var x0=mx+c*cw+((off*cw)%cw),hw=cw*D;ctx.moveTo(x0,my+pwmH);ctx.lineTo(x0,my);ctx.lineTo(x0+hw,my);ctx.lineTo(x0+hw,my+pwmH);ctx.lineTo(x0+cw,my+pwmH);}\n  ctx.stroke();\n  ctx.fillStyle='#64748b';ctx.font='bold 11px sans-serif';ctx.textAlign='left';ctx.fillText('等效直流 Vavg = '+(D*A).toFixed(2)+' V',mx,avgY-8);\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(mx,avgY);ctx.lineTo(mx,avgY+pwmH);ctx.lineTo(mx+gw,avgY+pwmH);ctx.stroke();\n  ctx.textAlign='right';ctx.font='9px monospace';ctx.fillStyle='#94a3b8';ctx.fillText(A.toFixed(1)+'V',mx-3,avgY+6);ctx.fillText('0V',mx-3,avgY+pwmH+3);\n  var vy=avgY+pwmH-(D*pwmH);\n  ctx.fillStyle='rgba(249,115,22,0.12)';ctx.fillRect(mx,vy,gw,avgY+pwmH-vy);\n  ctx.strokeStyle='#f97316';ctx.lineWidth=2.5;ctx.setLineDash([7,4]);ctx.beginPath();ctx.moveTo(mx,vy);ctx.lineTo(mx+gw,vy);ctx.stroke();ctx.setLineDash([]);\n  ctx.fillStyle='#ea580c';ctx.font='bold 12px monospace';ctx.textAlign='right';ctx.fillText((D*A).toFixed(2)+' V',mx+gw-5,vy-6);\n  off+=0.003;requestAnimationFrame(draw);\n}\n['duty-slider','amp-slider','freq-slider'].forEach(function(id){document.getElementById(id).addEventListener('input',update);});\nupdate();draw();\n\nwindow.addEventListener('message',function(e){\n  var d=e.data;if(!d||!d.type)return;\n  if(d.type==='SET_WIDGET_STATE'&&d.state){\n    Object.entries(d.state).forEach(function(kv){\n      var el=document.getElementById(kv[0]+'-slider')||document.querySelector('[data-var=\"'+kv[0]+'\"]');\n      if(el){el.value=kv[1];el.dispatchEvent(new Event('input',{bubbles:true}));}\n    });\n  }\n  if(d.type==='HIGHLIGHT_ELEMENT'){\n    var el=document.querySelector(d.target);\n    if(el){el.style.outline='3px solid #0ea5e9';el.style.outlineOffset='3px';setTimeout(function(){el.style.outline='';},3000);}\n  }\n});\n</script></body></html>",
