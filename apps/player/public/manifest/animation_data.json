{"p3-led-blink": {"block_id": "p3-led-blink-anim", "format": "html", "metadata": {"topic": "LED限流电路电流流动", "interactive": true, "engine": "canvas2d"}, "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1\"><title>LED 限流电路动画</title><script type=\"application/json\" id=\"widget-config\">{\"type\": \"simulation\", \"concept\": \"led_circuit\", \"description\": \"LED限流电路电流流动原理\", \"variables\": [{\"name\": \"resistance\", \"label\": \"限流电阻\", \"min\": 100, \"max\": 1000, \"default\": 220, \"unit\": \"Ω\"}, {\"name\": \"voltage\", \"label\": \"GPIO电压\", \"min\": 0, \"max\": 3.3, \"default\": 3.3, \"unit\": \"V\"}], \"steps\": [\"电路概览\", \"GPIO输出\", \"电流计算\", \"限流电阻\", \"LED正向压降\", \"电流流向\", \"亮度变化\", \"总结公式\"], \"engine\": \"canvas2d\", \"teachable\": true}</script><style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;overflow-x:hidden;font-family:'PingFang SC',system-ui,sans-serif}\nbody{background:#fff;color:#0f172a;display:flex;flex-direction:column;min-height:100vh}\n.anim-header{\n  padding:10px 16px;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);\n  border-bottom:1px solid #bae6fd;display:flex;align-items:center;gap:10px;flex-shrink:0}\n.anim-header .badge{\n  font-size:10.5px;font-weight:700;letter-spacing:.08em;\n  color:#0369a1;background:#e0f2fe;border:1px solid #bae6fd;\n  padding:3px 10px;border-radius:999px;text-transform:uppercase}\n.anim-header h3{font-size:13.5px;font-weight:600;color:#0c4a6e;flex:1}\n.anim-header .goal{font-size:11px;color:#0369a1;opacity:.8}\n.ctrl-panel{\n  padding:10px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:10px 20px;flex-shrink:0}\n.ctrl{flex:1;min-width:160px;max-width:260px}\n.ctrl label{font-size:11px;color:#64748b;display:flex;justify-content:space-between;margin-bottom:3px}\n.ctrl label span{font-weight:700;color:#0369a1;font-family:monospace}\n.ctrl input[type=range]{\n  width:100%;accent-color:#0ea5e9;height:4px;cursor:pointer;touch-action:manipulation}\n.presets{\n  padding:6px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:6px;flex-shrink:0}\n.preset-btn{\n  padding:5px 13px;border-radius:7px;border:1px solid #cbd5e1;\n  background:#fff;color:#334155;cursor:pointer;font-size:11.5px;\n  transition:all .15s;touch-action:manipulation;min-height:36px}\n.preset-btn:hover{border-color:#0ea5e9;color:#0ea5e9;background:#f0f9ff}\n.preset-btn.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n.canvas-area{flex:1;position:relative;min-height:240px;padding:12px}\ncanvas{\n  width:100%;height:100%;display:block;\n  background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;\n  cursor:crosshair}\n.info-bar{\n  padding:8px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:8px;flex-shrink:0}\n.info-item{text-align:center;flex:1;min-width:70px;padding:4px 8px;\n  background:#fff;border:1px solid #e2e8f0;border-radius:8px}\n.info-item .val{font-size:15px;font-weight:700;font-family:monospace;color:#0369a1;line-height:1.3}\n.info-item .lbl{font-size:10px;color:#94a3b8;line-height:1.2}\n.step-dots{display:flex;gap:6px;justify-content:center;padding:8px;flex-shrink:0}\n.step-dot{\n  width:8px;height:8px;border-radius:50%;background:#cbd5e1;\n  cursor:pointer;transition:all .2s}\n.step-dot.active{background:#0ea5e9;transform:scale(1.3)}\n.step-dot.done{background:#bae6fd}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}\n.pulsing{animation:pulse 1.2s infinite}\n@media(max-width:480px){.ctrl{min-width:140px;max-width:100%}}\n</style></head><body><div class=\"anim-header\">  <span class=\"badge\">原理动画</span>  <h3>LED 限流电路动画</h3>  <span class=\"goal\">🎯 理解 I=(V-Vf)/R</span></div>\n<div class=\"ctrl-panel\">\n  <div class=\"ctrl\">\n    <label>限流电阻 R <span id=\"r-lbl\">220 Ω</span></label>\n    <input type=\"range\" id=\"resistance-slider\" data-var=\"resistance\" min=\"100\" max=\"1000\" value=\"220\" step=\"10\">\n  </div>\n  <div class=\"ctrl\">\n    <label>GPIO 电压 <span id=\"v-lbl\">3.3 V</span></label>\n    <input type=\"range\" id=\"voltage-slider\" data-var=\"voltage\" min=\"0\" max=\"3.3\" value=\"3.3\" step=\"0.1\">\n  </div>\n</div>\n<div class=\"presets\">\n  <button class=\"preset-btn active\" onclick=\"setPreset(220,3.3,this)\">安全驱动 220Ω</button>\n  <button class=\"preset-btn\" onclick=\"setPreset(100,3.3,this)\">⚠ 过流 100Ω</button>\n  <button class=\"preset-btn\" onclick=\"setPreset(470,3.3,this)\">低亮度 470Ω</button>\n  <button class=\"preset-btn\" onclick=\"setPreset(1000,3.3,this)\">高阻 1kΩ</button>\n</div>\n<div class=\"canvas-area\"><canvas id=\"cv\"></canvas></div>\n<div class=\"info-bar\">\n  <div class=\"info-item\"><div class=\"val\" id=\"i-val\">5.9</div><div class=\"lbl\">电流 I (mA)</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"p-val\">11.8</div><div class=\"lbl\">功耗 P (mW)</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"s-val\" style=\"color:#059669\">✓ 安全</div><div class=\"lbl\">状态</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"f-val\" style=\"font-size:11px\">I=(V-Vf)/R</div><div class=\"lbl\">核心公式</div></div>\n</div>\n<div class=\"step-dots\" id=\"dots\"></div><script>\n\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nvar t=0, step=0;\nvar RS=document.getElementById('resistance-slider'), VS=document.getElementById('voltage-slider');\n\nfunction resize(){cv.width=cv.parentElement.clientWidth-24;cv.height=Math.max(cv.parentElement.clientHeight-24,200);draw();}\nnew ResizeObserver(resize).observe(cv.parentElement); resize();\n\nvar STEPS=[\"电路概览\",\"GPIO输出\",\"电流计算\",\"限流电阻\",\"LED压降\",\"电流流向\",\"亮度变化\",\"核心公式\"];\nvar dotsEl=document.getElementById('dots');\nSTEPS.forEach(function(s,i){\n  var d=document.createElement('div');d.className='step-dot'+(i===0?' active':'');\n  d.title=s;d.onclick=function(){onStep(i);};dotsEl.appendChild(d);\n});\n\nfunction onStep(s){\n  step=Math.max(0,Math.min(s,STEPS.length-1));\n  document.querySelectorAll('.step-dot').forEach(function(d,i){\n    d.className='step-dot'+(i===step?' active':(i<step?' done':''));\n  });\n}\n\nfunction setPreset(r,v,btn){\n  RS.value=r;VS.value=v;\n  document.querySelectorAll('.preset-btn').forEach(function(b){b.classList.remove('active');});\n  if(btn)btn.classList.add('active'); update();\n}\n\nfunction update(){\n  var R=+RS.value,V=+VS.value,Vf=2.0;\n  document.getElementById('r-lbl').textContent=R+' Ω';\n  document.getElementById('v-lbl').textContent=V.toFixed(1)+' V';\n  var I=V>Vf?(V-Vf)/R*1000:0, P=Vf*I;\n  document.getElementById('i-val').textContent=I.toFixed(2);\n  document.getElementById('p-val').textContent=P.toFixed(1);\n  var sv=document.getElementById('s-val');\n  if(I>20){sv.textContent='⚠ 过流!';sv.style.color='#dc2626';}\n  else if(I<0.5){sv.textContent='○ 熄灭';sv.style.color='#94a3b8';}\n  else{sv.textContent='✓ 安全';sv.style.color='#059669';}\n}\n\nfunction rrPath(ctx,x,y,w,h,r){\n  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);\n  ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);\n  ctx.lineTo(x+r,y+h);ctx.arcTo(x,y+h,x,y+h-r,r);\n  ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath();\n}\nfunction rr(ctx,x,y,w,h,r,fill,stroke){\n  rrPath(ctx,x,y,w,h,r);\n  if(fill){ctx.fillStyle=fill;ctx.fill();}\n  if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1.5;ctx.stroke();}\n}\n\nfunction draw(){\n  var w=cv.width,h=cv.height;\n  ctx.clearRect(0,0,w,h);\n  ctx.fillStyle='#f8fafc';ctx.fillRect(0,0,w,h);\n  var R=+RS.value,V=+VS.value,Vf=2.0;\n  var I=V>Vf?(V-Vf)/R*1000:0, bright=Math.min(I/15,1);\n\n  var cy=h*0.42, totalW=w-40;\n  var gpioW=76, resW=88, ledR=26, gndW=64;\n  var gap=Math.max(24, (totalW-gpioW-resW-ledR*2-gndW)/3);\n  var gpioX=20, resX=gpioX+gpioW+gap, ledX=resX+resW+gap+ledR;\n  var gndX=ledX+ledR+gap;\n\n  // 导线\n  ctx.strokeStyle='#94a3b8';ctx.lineWidth=2.5;\n  [[gpioX+gpioW,cy],[resX,cy],[resX+resW,cy],[ledX-ledR,cy],[ledX+ledR,cy],[gndX,cy]].reduce(function(a,b){\n    if(a){ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.stroke();}return b;\n  },null);\n\n  // GPIO\n  rr(ctx,gpioX,cy-22,gpioW,44,8,step>=1?'#0369a1':'#334155','transparent');\n  ctx.fillStyle='#fff';ctx.font='bold 11px monospace';ctx.textAlign='center';\n  ctx.fillText('GPIO',gpioX+gpioW/2,cy-4);\n  ctx.font='9.5px sans-serif';ctx.fillText('PA5',gpioX+gpioW/2,cy+10);\n  if(step>=1){ctx.fillStyle='#7dd3fc';ctx.font='10px monospace';ctx.fillText(V.toFixed(1)+'V↑',gpioX+gpioW/2,cy-16);}\n\n  // 限流电阻\n  var rHL=step===3||step===2;\n  rr(ctx,resX,cy-16,resW,32,6,rHL?'#fef9c3':'#f1f5f9',rHL?'#ca8a04':'#cbd5e1');\n  ctx.fillStyle=rHL?'#854d0e':'#475569';ctx.font='bold 11px monospace';ctx.textAlign='center';\n  ctx.fillText(R+'Ω',resX+resW/2,cy+4);\n  if(step>=2){ctx.font='9.5px sans-serif';ctx.fillStyle='#64748b';ctx.fillText('限流电阻',resX+resW/2,cy-8);}\n\n  // LED圆\n  var ledFill=I>0?'rgba(239,68,68,'+(0.15+bright*0.85)+')':'#f1f5f9';\n  ctx.beginPath();ctx.arc(ledX,cy,ledR,0,Math.PI*2);\n  ctx.fillStyle=ledFill;ctx.fill();\n  ctx.strokeStyle=I>20?'#dc2626':(step>=4?'#f97316':'#cbd5e1');ctx.lineWidth=2;ctx.stroke();\n  if(I>0.5){\n    var g=ctx.createRadialGradient(ledX,cy,ledR,ledX,cy,ledR*2.5);\n    g.addColorStop(0,'rgba(239,68,68,'+(bright*0.3)+')');g.addColorStop(1,'rgba(239,68,68,0)');\n    ctx.fillStyle=g;ctx.beginPath();ctx.arc(ledX,cy,ledR*2.5,0,Math.PI*2);ctx.fill();\n  }\n  ctx.fillStyle=I>0?'#991b1b':'#94a3b8';ctx.font='bold 10px sans-serif';ctx.textAlign='center';\n  ctx.fillText('LED',ledX,cy+4);\n  if(step>=4){ctx.font='9.5px sans-serif';ctx.fillStyle='#ea580c';ctx.fillText('Vf='+Vf+'V',ledX,cy-ledR-5);}\n\n  // GND\n  rr(ctx,gndX,cy-16,gndW,32,6,'#f1f5f9','#cbd5e1');\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='center';\n  ctx.fillText('GND',gndX+gndW/2,cy+4);\n\n  // 电流粒子\n  if(I>0.3&&step>=5){\n    var phase=(t%80)/80;\n    var segs=[[gpioX+gpioW,resX],[resX+resW,ledX-ledR],[ledX+ledR,gndX+gndW/2]];\n    segs.forEach(function(seg,si){\n      var pp=((phase+si/segs.length)%1);\n      var px=seg[0]+(seg[1]-seg[0])*pp, py=cy;\n      ctx.beginPath();ctx.arc(px,py,5,0,Math.PI*2);\n      ctx.fillStyle='rgba(14,165,233,'+(0.5+bright*0.5)+')';ctx.fill();\n      var trail=4;\n      for(var q=1;q<=trail;q++){\n        var tp=((phase+si/segs.length-q*0.015+1)%1);\n        var tx2=seg[0]+(seg[1]-seg[0])*tp;\n        ctx.beginPath();ctx.arc(tx2,py,3-q*0.5,0,Math.PI*2);\n        ctx.fillStyle='rgba(14,165,233,'+(0.3-q*0.06)+')';ctx.fill();\n      }\n    });\n  }\n\n  // 提示条\n  var hints=[\n    'GPIO → 限流电阻 → LED → GND，点击步骤点逐步了解',\n    'GPIO(PA5)输出'+V.toFixed(1)+'V高电平，为电路提供驱动电压',\n    'I = (V - Vf) / R = ('+V.toFixed(1)+' - '+Vf+') / '+R+' = '+I.toFixed(2)+' mA',\n    '限流电阻'+R+'Ω 限制电流，保护 LED 不被烧毁',\n    'LED 正向压降 Vf ≈ 2.0V（红色），固定消耗电压',\n    '蓝色粒子代表电流方向：GPIO → R → LED → GND',\n    I>0?'LED 亮度 '+(bright*100).toFixed(0)+'%，调节 R 可改变亮度':'GPIO=0V，LED 熄灭',\n    '📌 核心公式：I = (Vgpio - Vf) / R，控制 R 即控制亮度',\n  ];\n  ctx.fillStyle='rgba(240,249,255,0.95)';\n  rrPath(ctx,12,h-46,w-24,36,8);ctx.fill();\n  ctx.strokeStyle='#bae6fd';ctx.lineWidth=1;ctx.stroke();\n  ctx.fillStyle='#0c4a6e';ctx.font='12px sans-serif';ctx.textAlign='center';\n  ctx.fillText(hints[step]||'',w/2,h-22);\n\n  t++;requestAnimationFrame(draw);\n}\n\nRS.addEventListener('input',update);VS.addEventListener('input',update);\nupdate();\n\n\n// ── OpenMAIC-compatible postMessage bridge ──\nwindow.addEventListener('message', function(event) {\n  var d = event.data;\n  if (!d || !d.type) return;\n  switch (d.type) {\n    case 'SET_WIDGET_STATE':\n      if (d.state) {\n        Object.entries(d.state).forEach(function(kv) {\n          var el = document.getElementById(kv[0]+'-slider')\n                || document.querySelector('[data-var=\"'+kv[0]+'\"]');\n          if (el) { el.value = kv[1]; el.dispatchEvent(new Event('input',{bubbles:true})); }\n        });\n      }\n      break;\n    case 'HIGHLIGHT_ELEMENT':\n      var hEl = document.querySelector(d.target);\n      if (hEl) {\n        hEl.style.outline = '3px solid rgba(139,92,246,0.8)';\n        hEl.style.outlineOffset = '4px';\n        setTimeout(function(){ hEl.style.outline=''; hEl.style.outlineOffset=''; }, 3000);\n      }\n      break;\n    case 'ANNOTATE_ELEMENT':\n      var aEl = document.querySelector(d.target);\n      if (aEl && d.content) {\n        var tip = document.createElement('div');\n        var r = aEl.getBoundingClientRect();\n        tip.style.cssText = 'position:fixed;top:'+(r.top-42)+'px;left:'+r.left+'px;'+\n          'background:rgba(79,125,255,0.95);color:#fff;padding:8px 14px;border-radius:8px;'+\n          'font-size:13px;z-index:9999;pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,0.2)';\n        tip.textContent = d.content;\n        document.body.appendChild(tip);\n        setTimeout(function(){ tip.remove(); }, 4000);\n      }\n      break;\n    case 'dgb-step':\n      if (typeof onStep === 'function') onStep(d.step || 0);\n      break;\n  }\n});\n// ── 高度上报（让宿主自适应 iframe 高度）──\nfunction reportHeight() {\n  var h = document.documentElement.scrollHeight;\n  window.parent.postMessage({ type: 'dgb-iframe-height', height: h }, '*');\n}\nnew ResizeObserver(reportHeight).observe(document.body);\nsetTimeout(reportHeight, 300);\n\n</script></body></html>"}, "p4-timer": {"block_id": "p4-timer-anim", "format": "html", "metadata": {"topic": "定时器PSC/ARR计数溢出", "interactive": true, "engine": "canvas2d"}, "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1\"><title>定时器计数原理动画</title><script type=\"application/json\" id=\"widget-config\">{\"type\": \"simulation\", \"concept\": \"timer_counter\", \"description\": \"定时器PSC分频与ARR溢出原理\", \"variables\": [{\"name\": \"psc\", \"label\": \"预分频PSC\", \"min\": 0, \"max\": 7199, \"default\": 71, \"unit\": \"\"}, {\"name\": \"arr\", \"label\": \"自动重装ARR\", \"min\": 0, \"max\": 9999, \"default\": 999, \"unit\": \"\"}], \"steps\": [\"时钟源\", \"PSC分频\", \"CNT开始\", \"递增中\", \"到达ARR\", \"溢出清零\", \"中断触发\", \"公式总结\"], \"engine\": \"canvas2d\", \"teachable\": true}</script><style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;overflow-x:hidden;font-family:'PingFang SC',system-ui,sans-serif}\nbody{background:#fff;color:#0f172a;display:flex;flex-direction:column;min-height:100vh}\n.anim-header{\n  padding:10px 16px;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);\n  border-bottom:1px solid #bae6fd;display:flex;align-items:center;gap:10px;flex-shrink:0}\n.anim-header .badge{\n  font-size:10.5px;font-weight:700;letter-spacing:.08em;\n  color:#0369a1;background:#e0f2fe;border:1px solid #bae6fd;\n  padding:3px 10px;border-radius:999px;text-transform:uppercase}\n.anim-header h3{font-size:13.5px;font-weight:600;color:#0c4a6e;flex:1}\n.anim-header .goal{font-size:11px;color:#0369a1;opacity:.8}\n.ctrl-panel{\n  padding:10px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:10px 20px;flex-shrink:0}\n.ctrl{flex:1;min-width:160px;max-width:260px}\n.ctrl label{font-size:11px;color:#64748b;display:flex;justify-content:space-between;margin-bottom:3px}\n.ctrl label span{font-weight:700;color:#0369a1;font-family:monospace}\n.ctrl input[type=range]{\n  width:100%;accent-color:#0ea5e9;height:4px;cursor:pointer;touch-action:manipulation}\n.presets{\n  padding:6px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:6px;flex-shrink:0}\n.preset-btn{\n  padding:5px 13px;border-radius:7px;border:1px solid #cbd5e1;\n  background:#fff;color:#334155;cursor:pointer;font-size:11.5px;\n  transition:all .15s;touch-action:manipulation;min-height:36px}\n.preset-btn:hover{border-color:#0ea5e9;color:#0ea5e9;background:#f0f9ff}\n.preset-btn.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n.canvas-area{flex:1;position:relative;min-height:240px;padding:12px}\ncanvas{\n  width:100%;height:100%;display:block;\n  background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;\n  cursor:crosshair}\n.info-bar{\n  padding:8px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:8px;flex-shrink:0}\n.info-item{text-align:center;flex:1;min-width:70px;padding:4px 8px;\n  background:#fff;border:1px solid #e2e8f0;border-radius:8px}\n.info-item .val{font-size:15px;font-weight:700;font-family:monospace;color:#0369a1;line-height:1.3}\n.info-item .lbl{font-size:10px;color:#94a3b8;line-height:1.2}\n.step-dots{display:flex;gap:6px;justify-content:center;padding:8px;flex-shrink:0}\n.step-dot{\n  width:8px;height:8px;border-radius:50%;background:#cbd5e1;\n  cursor:pointer;transition:all .2s}\n.step-dot.active{background:#0ea5e9;transform:scale(1.3)}\n.step-dot.done{background:#bae6fd}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}\n.pulsing{animation:pulse 1.2s infinite}\n@media(max-width:480px){.ctrl{min-width:140px;max-width:100%}}\n</style></head><body><div class=\"anim-header\">  <span class=\"badge\">原理动画</span>  <h3>定时器计数原理动画</h3>  <span class=\"goal\">🎯 掌握 T=(PSC+1)×(ARR+1)/CLK</span></div>\n<div class=\"ctrl-panel\">\n  <div class=\"ctrl\">\n    <label>预分频 PSC <span id=\"psc-lbl\">71</span></label>\n    <input type=\"range\" id=\"psc-slider\" data-var=\"psc\" min=\"0\" max=\"7199\" value=\"71\">\n  </div>\n  <div class=\"ctrl\">\n    <label>自动重装 ARR <span id=\"arr-lbl\">999</span></label>\n    <input type=\"range\" id=\"arr-slider\" data-var=\"arr\" min=\"0\" max=\"9999\" value=\"999\">\n  </div>\n</div>\n<div class=\"presets\">\n  <button class=\"preset-btn active\" onclick=\"sp(71,999,this)\">1 ms</button>\n  <button class=\"preset-btn\" onclick=\"sp(71,9999,this)\">10 ms</button>\n  <button class=\"preset-btn\" onclick=\"sp(7199,9999,this)\">1 s</button>\n  <button class=\"preset-btn\" onclick=\"sp(0,71,this)\">超快 μs</button>\n</div>\n<div class=\"canvas-area\"><canvas id=\"cv\"></canvas></div>\n<div class=\"info-bar\">\n  <div class=\"info-item\"><div class=\"val\" id=\"fc-v\">1.00 MHz</div><div class=\"lbl\">计数频率</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"T-v\">1.00 ms</div><div class=\"lbl\">溢出周期 T</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"cnt-v\">0</div><div class=\"lbl\">当前 CNT</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"pct-v\">0%</div><div class=\"lbl\">进度</div></div>\n</div>\n<div class=\"step-dots\" id=\"dots\"></div><script>\n\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nvar t=0,step=0,cnt=0,ovFlash=0;\nvar SYSCLK=72e6;\nvar STEPS=[\"时钟源\",\"PSC分频\",\"CNT开始\",\"递增中\",\"到达ARR\",\"溢出清零\",\"中断触发\",\"公式总结\"];\n\nfunction resize(){cv.width=cv.parentElement.clientWidth-24;cv.height=Math.max(cv.parentElement.clientHeight-24,200);draw();}\nnew ResizeObserver(resize).observe(cv.parentElement);resize();\n\nvar dotsEl=document.getElementById('dots');\nSTEPS.forEach(function(s,i){\n  var d=document.createElement('div');d.className='step-dot'+(i===0?' active':'');\n  d.title=s;d.onclick=function(){onStep(i);};dotsEl.appendChild(d);\n});\nfunction onStep(s){step=Math.max(0,Math.min(s,STEPS.length-1));document.querySelectorAll('.step-dot').forEach(function(d,i){d.className='step-dot'+(i===step?' active':(i<step?' done':''));});}\nfunction sp(p,a,btn){document.getElementById('psc-slider').value=p;document.getElementById('arr-slider').value=a;document.querySelectorAll('.preset-btn').forEach(function(b){b.classList.remove('active');});if(btn)btn.classList.add('active');upd();}\n\nfunction fmtHz(f){return f>=1e6?(f/1e6).toFixed(2)+' MHz':f>=1e3?(f/1e3).toFixed(1)+' kHz':f.toFixed(0)+' Hz';}\nfunction fmtT(T){return T>=1?T.toFixed(3)+' s':T>=0.001?(T*1e3).toFixed(3)+' ms':(T*1e6).toFixed(1)+' μs';}\n\nfunction upd(){\n  var PSC=+document.getElementById('psc-slider').value, ARR=+document.getElementById('arr-slider').value;\n  document.getElementById('psc-lbl').textContent=PSC;\n  document.getElementById('arr-lbl').textContent=ARR;\n  var fc=SYSCLK/(PSC+1), T=(ARR+1)/fc;\n  document.getElementById('fc-v').textContent=fmtHz(fc);\n  document.getElementById('T-v').textContent=fmtT(T);\n}\n\nfunction rrPath(ctx,x,y,w,h,r){\n  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);\n  ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);\n  ctx.lineTo(x+r,y+h);ctx.arcTo(x,y+h,x,y+h-r,r);\n  ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath();\n}\n\nfunction draw(){\n  var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);\n  ctx.fillStyle='#f8fafc';ctx.fillRect(0,0,w,h);\n  var PSC=+document.getElementById('psc-slider').value, ARR=+document.getElementById('arr-slider').value;\n  var fc=SYSCLK/(PSC+1), T=(ARR+1)/fc;\n\n  var spd=Math.max(1,Math.min(12,ARR/150));\n  cnt+=spd; if(cnt>=ARR+1){cnt=0;ovFlash=15;}\n  if(ovFlash>0)ovFlash--;\n  var pct=cnt/(ARR+1);\n  document.getElementById('cnt-v').textContent=Math.floor(cnt);\n  document.getElementById('pct-v').textContent=(pct*100).toFixed(1)+'%';\n\n  var mx=58,my=30,gw=w-mx-16,gh=Math.min((h-110)/2,78);\n\n  // ── 时钟波形 ──\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='right';\n  ctx.fillText(step>=1?'SYSCLK':'时钟',mx-4,my+gh/2+4);\n  if(step>=0){\n    var nc=14,cw=gw/nc;\n    ctx.strokeStyle='#0ea5e9';ctx.lineWidth=1.5;\n    ctx.beginPath();\n    for(var i=0;i<nc;i++){var xc=mx+i*cw;ctx.moveTo(xc,my+gh);ctx.lineTo(xc,my);ctx.lineTo(xc+cw*0.5,my);ctx.lineTo(xc+cw*0.5,my+gh);ctx.lineTo(xc+cw,my+gh);}\n    ctx.stroke();\n    if(step===0){ctx.fillStyle='#0369a1';ctx.font='10px sans-serif';ctx.textAlign='center';ctx.fillText('72 MHz 系统时钟',mx+gw/2,my-5);}\n  }\n\n  // ── PSC 分频后的计数时钟（step>=1 显示） ──\n  var my1b=my+gh+12;\n  if(step>=1){\n    ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='right';\n    ctx.fillText('÷'+(PSC+1),mx-4,my1b+gh/2+4);\n    var nc2=Math.min(7,Math.max(2,Math.floor(14/(PSC+1))+1)), cw2=gw/nc2;\n    ctx.strokeStyle='#f97316';ctx.lineWidth=2;\n    ctx.beginPath();\n    for(var j=0;j<nc2;j++){var xd=mx+j*cw2;ctx.moveTo(xd,my1b+gh);ctx.lineTo(xd,my1b);ctx.lineTo(xd+cw2*0.5,my1b);ctx.lineTo(xd+cw2*0.5,my1b+gh);ctx.lineTo(xd+cw2,my1b+gh);}\n    ctx.stroke();\n    ctx.fillStyle='#ea580c';ctx.font='10px sans-serif';ctx.textAlign='center';\n    ctx.fillText(fmtHz(fc),mx+gw/2,my1b-4);\n  }\n\n  // ── CNT 锯齿波 ──\n  var my2=my1b+gh+18;\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='right';\n  ctx.fillText('CNT',mx-4,my2+gh/2+4);\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(mx,my2);ctx.lineTo(mx,my2+gh);ctx.lineTo(mx+gw,my2+gh);ctx.stroke();\n  ctx.fillStyle='#94a3b8';ctx.font='9px monospace';ctx.textAlign='right';\n  ctx.fillText(ARR,mx-3,my2+5);ctx.fillText('0',mx-3,my2+gh+3);\n  var cyw=gw/3;\n  ctx.strokeStyle='#0ea5e9';ctx.lineWidth=2.5;\n  for(var ci=0;ci<2;ci++){ctx.beginPath();ctx.moveTo(mx+ci*cyw,my2+gh);ctx.lineTo(mx+(ci+1)*cyw-2,my2);ctx.moveTo(mx+(ci+1)*cyw-2,my2);ctx.lineTo(mx+(ci+1)*cyw-2,my2+gh);ctx.stroke();}\n  // 当前上升段\n  ctx.beginPath();ctx.moveTo(mx+2*cyw,my2+gh);ctx.lineTo(mx+2*cyw+pct*cyw,my2+gh-pct*gh);\n  ctx.strokeStyle=ovFlash>0?'#dc2626':'#0ea5e9';ctx.lineWidth=3;ctx.stroke();\n  // 当前 CNT 球\n  ctx.beginPath();ctx.arc(mx+2*cyw+pct*cyw,my2+gh-pct*gh,5,0,Math.PI*2);\n  ctx.fillStyle='#0ea5e9';ctx.fill();\n  // ARR 线\n  ctx.strokeStyle='#f97316';ctx.lineWidth=1;ctx.setLineDash([5,4]);\n  ctx.beginPath();ctx.moveTo(mx,my2);ctx.lineTo(mx+gw,my2);ctx.stroke();ctx.setLineDash([]);\n  ctx.fillStyle='#ea580c';ctx.font='10px monospace';ctx.textAlign='right';\n  ctx.fillText('ARR='+ARR,mx+gw-2,my2-4);\n  // 溢出闪光\n  if(ovFlash>0){\n    ctx.fillStyle='rgba(220,38,38,'+(ovFlash/15*0.2)+')';ctx.fillRect(mx,my2,gw,gh);\n    ctx.fillStyle='#dc2626';ctx.font='bold 12px sans-serif';ctx.textAlign='center';\n    ctx.fillText('溢出 → 清零 → 中断！',mx+gw/2,my2+gh/2+4);\n  }\n\n  // 提示条\n  var hints=[\n    'SYSCLK = 72 MHz，定时器挂载在 APB1/APB2 总线',\n    'PSC='+PSC+'，计数时钟 = 72MHz÷('+PSC+'+1) = '+fmtHz(fc),\n    'CNT 寄存器从 0 开始，每个计数时钟周期自动加 1',\n    'CNT 当前 = '+Math.floor(cnt)+'，共需计 '+(ARR+1)+' 次',\n    'CNT = ARR = '+ARR+'，下一个时钟触发溢出事件',\n    'CNT 复位为 0，重新开始计数（周期精确）',\n    '溢出产生 UIF 标志，触发定时器中断回调（HAL_TIM_PeriodElapsedCallback）',\n    '📌 T = (PSC+1)×(ARR+1)/72MHz = '+fmtT(T),\n  ];\n  ctx.fillStyle='rgba(240,249,255,0.95)';\n  rrPath(ctx,12,h-46,w-24,36,8);ctx.fill();\n  ctx.strokeStyle='#bae6fd';ctx.lineWidth=1;ctx.stroke();\n  ctx.fillStyle='#0c4a6e';ctx.font='12px sans-serif';ctx.textAlign='center';\n  ctx.fillText(hints[step]||'',w/2,h-22);\n\n  t++;requestAnimationFrame(draw);\n}\n\ndocument.getElementById('psc-slider').addEventListener('input',upd);\ndocument.getElementById('arr-slider').addEventListener('input',upd);\nupd();\n\n\n// ── OpenMAIC-compatible postMessage bridge ──\nwindow.addEventListener('message', function(event) {\n  var d = event.data;\n  if (!d || !d.type) return;\n  switch (d.type) {\n    case 'SET_WIDGET_STATE':\n      if (d.state) {\n        Object.entries(d.state).forEach(function(kv) {\n          var el = document.getElementById(kv[0]+'-slider')\n                || document.querySelector('[data-var=\"'+kv[0]+'\"]');\n          if (el) { el.value = kv[1]; el.dispatchEvent(new Event('input',{bubbles:true})); }\n        });\n      }\n      break;\n    case 'HIGHLIGHT_ELEMENT':\n      var hEl = document.querySelector(d.target);\n      if (hEl) {\n        hEl.style.outline = '3px solid rgba(139,92,246,0.8)';\n        hEl.style.outlineOffset = '4px';\n        setTimeout(function(){ hEl.style.outline=''; hEl.style.outlineOffset=''; }, 3000);\n      }\n      break;\n    case 'ANNOTATE_ELEMENT':\n      var aEl = document.querySelector(d.target);\n      if (aEl && d.content) {\n        var tip = document.createElement('div');\n        var r = aEl.getBoundingClientRect();\n        tip.style.cssText = 'position:fixed;top:'+(r.top-42)+'px;left:'+r.left+'px;'+\n          'background:rgba(79,125,255,0.95);color:#fff;padding:8px 14px;border-radius:8px;'+\n          'font-size:13px;z-index:9999;pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,0.2)';\n        tip.textContent = d.content;\n        document.body.appendChild(tip);\n        setTimeout(function(){ tip.remove(); }, 4000);\n      }\n      break;\n    case 'dgb-step':\n      if (typeof onStep === 'function') onStep(d.step || 0);\n      break;\n  }\n});\n// ── 高度上报（让宿主自适应 iframe 高度）──\nfunction reportHeight() {\n  var h = document.documentElement.scrollHeight;\n  window.parent.postMessage({ type: 'dgb-iframe-height', height: h }, '*');\n}\nnew ResizeObserver(reportHeight).observe(document.body);\nsetTimeout(reportHeight, 300);\n\n</script></body></html>"}, "p5-pwm": {"block_id": "p5-pwm-anim", "format": "html", "metadata": {"topic": "PWM占空比与等效电压", "interactive": true, "engine": "canvas2d"}, "html": "<!DOCTYPE html><html lang=\"zh\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1\"><title>PWM占空比动画</title><script type=\"application/json\" id=\"widget-config\">{\"type\": \"simulation\", \"concept\": \"pwm_duty\", \"description\": \"PWM占空比与等效电压关系\", \"variables\": [{\"name\": \"duty\", \"label\": \"占空比\", \"min\": 0, \"max\": 100, \"default\": 50, \"unit\": \"%\"}, {\"name\": \"amp\", \"label\": \"幅值\", \"min\": 0, \"max\": 3.3, \"default\": 3.3, \"unit\": \"V\"}], \"steps\": [\"PWM概念\", \"高低电平\", \"周期结构\", \"占空比\", \"等效电压\", \"实际应用\", \"LED亮度\", \"呼吸效果\"], \"engine\": \"canvas2d\", \"teachable\": true}</script><style>\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{width:100%;overflow-x:hidden;font-family:'PingFang SC',system-ui,sans-serif}\nbody{background:#fff;color:#0f172a;display:flex;flex-direction:column;min-height:100vh}\n.anim-header{\n  padding:10px 16px;background:linear-gradient(135deg,#f0f9ff,#e0f2fe);\n  border-bottom:1px solid #bae6fd;display:flex;align-items:center;gap:10px;flex-shrink:0}\n.anim-header .badge{\n  font-size:10.5px;font-weight:700;letter-spacing:.08em;\n  color:#0369a1;background:#e0f2fe;border:1px solid #bae6fd;\n  padding:3px 10px;border-radius:999px;text-transform:uppercase}\n.anim-header h3{font-size:13.5px;font-weight:600;color:#0c4a6e;flex:1}\n.anim-header .goal{font-size:11px;color:#0369a1;opacity:.8}\n.ctrl-panel{\n  padding:10px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:10px 20px;flex-shrink:0}\n.ctrl{flex:1;min-width:160px;max-width:260px}\n.ctrl label{font-size:11px;color:#64748b;display:flex;justify-content:space-between;margin-bottom:3px}\n.ctrl label span{font-weight:700;color:#0369a1;font-family:monospace}\n.ctrl input[type=range]{\n  width:100%;accent-color:#0ea5e9;height:4px;cursor:pointer;touch-action:manipulation}\n.presets{\n  padding:6px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:6px;flex-shrink:0}\n.preset-btn{\n  padding:5px 13px;border-radius:7px;border:1px solid #cbd5e1;\n  background:#fff;color:#334155;cursor:pointer;font-size:11.5px;\n  transition:all .15s;touch-action:manipulation;min-height:36px}\n.preset-btn:hover{border-color:#0ea5e9;color:#0ea5e9;background:#f0f9ff}\n.preset-btn.active{background:#0ea5e9;color:#fff;border-color:#0ea5e9}\n.canvas-area{flex:1;position:relative;min-height:240px;padding:12px}\ncanvas{\n  width:100%;height:100%;display:block;\n  background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;\n  cursor:crosshair}\n.info-bar{\n  padding:8px 16px;background:#f8fafc;border-top:1px solid #e2e8f0;\n  display:flex;flex-wrap:wrap;gap:8px;flex-shrink:0}\n.info-item{text-align:center;flex:1;min-width:70px;padding:4px 8px;\n  background:#fff;border:1px solid #e2e8f0;border-radius:8px}\n.info-item .val{font-size:15px;font-weight:700;font-family:monospace;color:#0369a1;line-height:1.3}\n.info-item .lbl{font-size:10px;color:#94a3b8;line-height:1.2}\n.step-dots{display:flex;gap:6px;justify-content:center;padding:8px;flex-shrink:0}\n.step-dot{\n  width:8px;height:8px;border-radius:50%;background:#cbd5e1;\n  cursor:pointer;transition:all .2s}\n.step-dot.active{background:#0ea5e9;transform:scale(1.3)}\n.step-dot.done{background:#bae6fd}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}\n.pulsing{animation:pulse 1.2s infinite}\n@media(max-width:480px){.ctrl{min-width:140px;max-width:100%}}\n</style></head><body><div class=\"anim-header\">  <span class=\"badge\">原理动画</span>  <h3>PWM占空比动画</h3>  <span class=\"goal\">🎯 理解 Vavg = D × Vmax</span></div>\n<div class=\"ctrl-panel\">\n  <div class=\"ctrl\">\n    <label>占空比 D <span id=\"d-lbl\">50%</span></label>\n    <input type=\"range\" id=\"duty-slider\" data-var=\"duty\" min=\"0\" max=\"100\" value=\"50\">\n  </div>\n  <div class=\"ctrl\">\n    <label>幅值 Vmax <span id=\"a-lbl\">3.3 V</span></label>\n    <input type=\"range\" id=\"amp-slider\" data-var=\"amp\" min=\"0\" max=\"3.3\" value=\"3.3\" step=\"0.1\">\n  </div>\n</div>\n<div class=\"presets\">\n  <button class=\"preset-btn\" onclick=\"sp(0,3.3,this)\">全灭 0%</button>\n  <button class=\"preset-btn\" onclick=\"sp(25,3.3,this)\">25%</button>\n  <button class=\"preset-btn active\" onclick=\"sp(50,3.3,this)\">50%</button>\n  <button class=\"preset-btn\" onclick=\"sp(75,3.3,this)\">75%</button>\n  <button class=\"preset-btn\" onclick=\"sp(100,3.3,this)\">全亮 100%</button>\n</div>\n<div class=\"canvas-area\"><canvas id=\"cv\"></canvas></div>\n<div class=\"info-bar\">\n  <div class=\"info-item\"><div class=\"val\" id=\"d-v\">50%</div><div class=\"lbl\">占空比 D</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"vavg-v\">1.65 V</div><div class=\"lbl\">等效电压 Vavg</div></div>\n  <div class=\"info-item\"><div class=\"val\" id=\"led-v\">50%</div><div class=\"lbl\">LED亮度</div></div>\n</div>\n<div class=\"step-dots\" id=\"dots\"></div><script>\n\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nvar t=0,step=0,breathDir=1,breathD=50;\nvar STEPS=[\"PWM概念\",\"高低电平\",\"周期结构\",\"占空比\",\"等效电压\",\"实际应用\",\"LED亮度\",\"呼吸效果\"];\n\nfunction resize(){cv.width=cv.parentElement.clientWidth-24;cv.height=Math.max(cv.parentElement.clientHeight-24,200);draw();}\nnew ResizeObserver(resize).observe(cv.parentElement);resize();\n\nvar dotsEl=document.getElementById('dots');\nSTEPS.forEach(function(s,i){\n  var d=document.createElement('div');d.className='step-dot'+(i===0?' active':'');\n  d.title=s;d.onclick=function(){onStep(i);};dotsEl.appendChild(d);\n});\nfunction onStep(s){step=Math.max(0,Math.min(s,STEPS.length-1));document.querySelectorAll('.step-dot').forEach(function(d,i){d.className='step-dot'+(i===step?' active':(i<step?' done':''));});}\nfunction sp(d,a,btn){document.getElementById('duty-slider').value=d;document.getElementById('amp-slider').value=a;document.querySelectorAll('.preset-btn').forEach(function(b){b.classList.remove('active');});if(btn)btn.classList.add('active');upd();}\n\nfunction upd(){\n  var D=+document.getElementById('duty-slider').value,A=+document.getElementById('amp-slider').value;\n  document.getElementById('d-lbl').textContent=D+'%';\n  document.getElementById('a-lbl').textContent=A.toFixed(1)+' V';\n  document.getElementById('d-v').textContent=D+'%';\n  document.getElementById('vavg-v').textContent=(D/100*A).toFixed(2)+' V';\n  document.getElementById('led-v').textContent=D+'%';\n}\n\nfunction rrPath(ctx,x,y,w,h,r){\n  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);\n  ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);\n  ctx.lineTo(x+r,y+h);ctx.arcTo(x,y+h,x,y+h-r,r);\n  ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath();\n}\n\nfunction draw(){\n  var w=cv.width,h=cv.height;ctx.clearRect(0,0,w,h);\n  ctx.fillStyle='#f8fafc';ctx.fillRect(0,0,w,h);\n\n  var D0=+document.getElementById('duty-slider').value,A=+document.getElementById('amp-slider').value;\n  // 步骤7：呼吸灯演示\n  var D=D0;\n  if(step===7){breathD+=breathDir*0.4;if(breathD>=95||breathD<=5)breathDir=-breathDir;D=breathD;}\n  var duty=D/100, vavg=duty*A;\n\n  var mx=52,my=22,gw=w-mx-16,gh=Math.min((h-110)/2,75);\n\n  // ── PWM波形 ──\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='right';\n  ctx.fillText('PWM',mx-4,my+gh/2+4);\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(mx,my+gh);ctx.lineTo(mx+gw,my+gh);ctx.stroke();\n  ctx.fillStyle='#94a3b8';ctx.font='9px monospace';ctx.textAlign='right';\n  ctx.fillText(A.toFixed(1)+'V',mx-3,my+5);ctx.fillText('0V',mx-3,my+gh+3);\n\n  var off=(t*0.004)%1, cyc=4, cw=gw/cyc;\n  ctx.strokeStyle='#0ea5e9';ctx.lineWidth=2.5;\n  ctx.beginPath();\n  for(var i=0;i<cyc;i++){\n    var x0=mx+i*cw, hw=cw*duty, shift=(off*cw)%cw;\n    var xs=x0; var xe=xs+cw;\n    var hstart=x0, hend=x0+hw;\n    ctx.moveTo(xs,my+gh);ctx.lineTo(hstart,my+gh);ctx.lineTo(hstart,my);\n    ctx.lineTo(hend,my);ctx.lineTo(hend,my+gh);ctx.lineTo(xe,my+gh);\n  }\n  ctx.stroke();\n\n  // 高电平填充\n  if(step>=1){\n    ctx.fillStyle='rgba(14,165,233,0.12)';\n    for(var j=0;j<cyc;j++){ctx.fillRect(mx+j*cw,my,cw*duty,gh);}\n    ctx.fillStyle='#0369a1';ctx.font='9px sans-serif';ctx.textAlign='center';\n    ctx.fillText('高 '+A.toFixed(1)+'V',mx+cw*duty/2,my+10);\n    if(duty<0.9){ctx.fillText('低 0V',mx+cw*duty+cw*(1-duty)/2,my+gh-4);}\n  }\n\n  // 占空比标注\n  if(step>=3){\n    ctx.strokeStyle='#f97316';ctx.lineWidth=1.5;ctx.setLineDash([3,3]);\n    ctx.beginPath();ctx.moveTo(mx,my-10);ctx.lineTo(mx+cw*duty,my-10);ctx.stroke();ctx.setLineDash([]);\n    ctx.fillStyle='#ea580c';ctx.font='bold 10px sans-serif';ctx.textAlign='center';\n    ctx.fillText('D = '+D.toFixed(0)+'%',mx+cw*duty/2,my-14);\n  }\n\n  // ── 等效电压区 ──\n  var my2=my+gh+28;\n  ctx.fillStyle='#64748b';ctx.font='bold 10px monospace';ctx.textAlign='right';\n  ctx.fillText('Vavg',mx-4,my2+gh/2+4);\n  ctx.strokeStyle='#e2e8f0';ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(mx,my2);ctx.lineTo(mx,my2+gh);ctx.lineTo(mx+gw,my2+gh);ctx.stroke();\n  ctx.fillStyle='#94a3b8';ctx.font='9px monospace';ctx.textAlign='right';\n  ctx.fillText(A.toFixed(1)+'V',mx-3,my2+5);ctx.fillText('0V',mx-3,my2+gh+3);\n\n  // 等效电平线\n  var vy=my2+gh-duty*gh;\n  ctx.fillStyle='rgba(249,115,22,0.1)';ctx.fillRect(mx,vy,gw,my2+gh-vy);\n  ctx.strokeStyle='#f97316';ctx.lineWidth=2.5;ctx.setLineDash([8,4]);\n  ctx.beginPath();ctx.moveTo(mx,vy);ctx.lineTo(mx+gw,vy);ctx.stroke();ctx.setLineDash([]);\n  ctx.fillStyle='#ea580c';ctx.font='bold 12px monospace';ctx.textAlign='right';\n  ctx.fillText(vavg.toFixed(2)+' V',mx+gw-4,vy-5);\n\n  // LED亮度条（step>=6）\n  if(step>=6){\n    var bw=Math.min(gw*0.4,160), bh=16, bx=mx+gw-bw-4, by=my2+gh+6;\n    ctx.fillStyle='#e2e8f0';ctx.fillRect(bx,by,bw,bh);\n    var ledColor='rgba(239,68,68,'+(0.15+duty*0.85)+')';\n    ctx.fillStyle=ledColor;ctx.fillRect(bx,by,bw*duty,bh);\n    ctx.strokeStyle='#cbd5e1';ctx.lineWidth=1;ctx.strokeRect(bx,by,bw,bh);\n    ctx.fillStyle='#334155';ctx.font='9px sans-serif';ctx.textAlign='center';\n    ctx.fillText('LED亮度',bx+bw/2,by+bh+11);\n  }\n\n  // 提示条\n  var hints=[\n    'PWM（脉冲宽度调制）：通过控制高电平占比来调节等效输出电压',\n    '每个周期内，高电平='+A.toFixed(1)+'V，低电平=0V，快速切换',\n    '周期 T = 1/f，TIM2 默认 1kHz，一个周期内有高和低两段时间',\n    '占空比 D = 高电平时间/周期 = '+D.toFixed(0)+'%，直接控制输出能量',\n    'Vavg = D × Vmax = '+duty.toFixed(2)+' × '+A.toFixed(1)+' = '+vavg.toFixed(2)+' V（等效直流）',\n    '应用：调光、电机调速、DAC近似、音频生成',\n    'LED亮度正比于平均电压：D='+D.toFixed(0)+'% → 亮度约'+D.toFixed(0)+'%',\n    '呼吸灯：D从0%~100%平滑变化，HAL_TIM_SET_COMPARE()动态设置',\n  ];\n  ctx.fillStyle='rgba(254,252,232,0.95)';\n  rrPath(ctx,12,h-46,w-24,36,8);ctx.fill();\n  ctx.strokeStyle='#fde68a';ctx.lineWidth=1;ctx.stroke();\n  ctx.fillStyle='#78350f';ctx.font='12px sans-serif';ctx.textAlign='center';\n  ctx.fillText(hints[step]||'',w/2,h-22);\n\n  t++;requestAnimationFrame(draw);\n}\ndocument.getElementById('duty-slider').addEventListener('input',upd);\ndocument.getElementById('amp-slider').addEventListener('input',upd);\nupd();\n\n\n// ── OpenMAIC-compatible postMessage bridge ──\nwindow.addEventListener('message', function(event) {\n  var d = event.data;\n  if (!d || !d.type) return;\n  switch (d.type) {\n    case 'SET_WIDGET_STATE':\n      if (d.state) {\n        Object.entries(d.state).forEach(function(kv) {\n          var el = document.getElementById(kv[0]+'-slider')\n                || document.querySelector('[data-var=\"'+kv[0]+'\"]');\n          if (el) { el.value = kv[1]; el.dispatchEvent(new Event('input',{bubbles:true})); }\n        });\n      }\n      break;\n    case 'HIGHLIGHT_ELEMENT':\n      var hEl = document.querySelector(d.target);\n      if (hEl) {\n        hEl.style.outline = '3px solid rgba(139,92,246,0.8)';\n        hEl.style.outlineOffset = '4px';\n        setTimeout(function(){ hEl.style.outline=''; hEl.style.outlineOffset=''; }, 3000);\n      }\n      break;\n    case 'ANNOTATE_ELEMENT':\n      var aEl = document.querySelector(d.target);\n      if (aEl && d.content) {\n        var tip = document.createElement('div');\n        var r = aEl.getBoundingClientRect();\n        tip.style.cssText = 'position:fixed;top:'+(r.top-42)+'px;left:'+r.left+'px;'+\n          'background:rgba(79,125,255,0.95);color:#fff;padding:8px 14px;border-radius:8px;'+\n          'font-size:13px;z-index:9999;pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,0.2)';\n        tip.textContent = d.content;\n        document.body.appendChild(tip);\n        setTimeout(function(){ tip.remove(); }, 4000);\n      }\n      break;\n    case 'dgb-step':\n      if (typeof onStep === 'function') onStep(d.step || 0);\n      break;\n  }\n});\n// ── 高度上报（让宿主自适应 iframe 高度）──\nfunction reportHeight() {\n  var h = document.documentElement.scrollHeight;\n  window.parent.postMessage({ type: 'dgb-iframe-height', height: h }, '*');\n}\nnew ResizeObserver(reportHeight).observe(document.body);\nsetTimeout(reportHeight, 300);\n\n</script></body></html>"}}